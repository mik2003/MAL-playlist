{
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "lib": [
            "dom",
            "es2017"
        ],
        "moduleResolution": "node",
        "outDir": "docs/js",
        "rootDir": "src/web",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "src/web/**/*"
    ]
}